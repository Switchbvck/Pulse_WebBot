# Pulse API environment (see app/config.py).
# Copy to .env and fill in as needed.

# Database URL (default: sqlite:///./pulse.db next to this folder)
PULSE_DB_URL=

# Bot token used to HMAC-validate X-Telegram-Init-Data from the Mini App.
# Required in production together with PULSE_ALLOW_ANONYMOUS=false.
PULSE_BOT_TOKEN=

# Comma-separated Telegram user IDs with admin access.
PULSE_ADMIN_IDS=

# Fail-closed by default: unauthenticated (browser dev) requests are rejected
# unless you opt in here. Anonymous callers are ORDINARY users — no admin.
PULSE_ALLOW_ANONYMOUS=false
# Local-dev convenience only: treat anonymous callers as admins.
# Never set to true on an internet-exposed instance.
PULSE_DEV_ADMIN=false

# initData signed at app launch is accepted for this many seconds (replay
# protection). 86400 = 24h; lower it if sessions are short.
PULSE_INITDATA_MAX_AGE=86400

# Telegram notifications: instant booking alerts go to this chat ID (0 = off).
PULSE_ADMIN_CHAT_ID=0
# Shared secret for machine-to-machine calls from the shell bot (X-Internal-Token).
PULSE_INTERNAL_TOKEN=

# Rate limits, "max-requests/window-seconds" per client.
PULSE_RATELIMIT_BOOKING=10/60
PULSE_RATELIMIT_ASSISTANT=30/60

# Fresh databases get demo bookings + reviews so the admin panel, analytics,
# and reviews look alive on first run. Ignored when services already exist.
PULSE_SEED_DEMO_DATA=true

# Extra allowed origins, comma-separated (defaults cover the Vite dev server).
PULSE_CORS_ORIGINS=
