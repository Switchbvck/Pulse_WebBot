# Base URL of the backend API.
# Leave EMPTY to run the app on built-in demo data (no backend required).
# Options for local development:
#   VITE_API_BASE_URL=/api                  -> proxied by Vite to http://localhost:8000
#   VITE_API_BASE_URL=http://localhost:8000 -> direct
VITE_API_BASE_URL=

# Comma-separated Telegram user IDs that see the Admin Panel tab in live mode.
# In demo mode (empty VITE_API_BASE_URL) the panel is always available.
# Frontend gating is a UX shortcut only — enforce /admin/* on the server.
VITE_ADMIN_IDS=
