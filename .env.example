TELEGRAM_TOKEN=your-telegram-token
CLINIC_NAME=Pulse
# Public HTTPS URL of the deployed Pulse Mini App (required for the launch button)
MINI_APP_URL=
LOG_LEVEL=INFO

# Pulse API connection for reminder callbacks (Confirm button in reminders).
PULSE_API_URL=http://127.0.0.1:8000
# Shared secret from backend/.env (PULSE_INTERNAL_TOKEN) — the bot issues
# login tokens and confirms attendance through it.
PULSE_INTERNAL_TOKEN=
